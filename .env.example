# Môi trường vận hành: development | test | staging | production
NODE_ENV=development
APP_NAME="Operon Hub"
APP_VERSION=1.0.0
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Cơ sở dữ liệu MySQL 8+ (Chỉ cho phép auto-migrate khi NODE_ENV=development và host là localhost/127.0.0.1)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_local_mysql_password
DB_NAME=operon_hub
DB_POOL_LIMIT=10

# Auth JWT Secrets (Sẽ dùng từ TASK-02 trở đi — tạo chuỗi ngẫu nhiên tối thiểu 32 ký tự)
JWT_ACCESS_SECRET=change_me_to_a_random_32_char_secret_key
JWT_REFRESH_SECRET=change_me_to_another_random_32_char_secret
